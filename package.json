{
  "name": "common-agent-config",
  "version": "1.0.0",
  "description": "Shared agent configuration for noshiro-pf repositories",
  "keywords": [],
  "license": "ISC",
  "author": "noshiro-pf",
  "scripts": {
    "cspell": "cspell \"{**,.changeset/**/*,.github/**/*}\" --gitignore --gitignore-root ./ --no-progress",
    "fmt": "format-uncommitted",
    "fmt:diff": "format-diff-from origin/main",
    "fmt:full": "prettier --write .",
    "md": "markdownlint-cli2",
    "repo-settings:apply": "repo-settings apply",
    "repo-settings:backup": "repo-settings backup",
    "update-packages": "pnpm update --latest"
  },
  "devDependencies": {
    "cspell": "10.0.1",
    "github-settings-as-code": "2.0.1",
    "markdownlint": "0.41.1",
    "markdownlint-cli2": "0.23.1",
    "prettier": "3.9.5",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-packagejson": "3.0.2",
    "ts-repo-utils": "10.1.2"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.0.0"
  },
  "volta": {
    "node": "25.9.0"
  }
}
